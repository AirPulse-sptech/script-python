# ============================================================================
# AGENTE (coleta real da bancada)
# ============================================================================
NOME_PROCESSO_ALVO=bancadaVoo
INTERVALO_COLETA_S=10
JANELA_DETECCAO_BANCADA_S=5

# AWS S3 (obrigatório para agente e simulador)
# Use estas chaves ou um perfil/role com acesso ao bucket.
#AWS_REGION=us-east-1
aws_access_key_id=
aws_secret_access_key=
aws_session_token=

# Buckets
BUCKET_NAME=airpulse-s3
S3_PREFIXO_BRONZE=01-bronze

# API de cadastro no Node (apenas agente real)
AGENTE_API_URL=http://ip-v4-publico:3333
AGENTE_EMAIL=
AGENTE_SENHA=

# RAM (opcional)
# RAM_TOTAL_BYTES=

# ============================================================================
# SIMULADOR (gera 30 dias de dados históricos para 8 FMCs)
# ============================================================================
DIAS_SIMULACAO=30
ACELERADOR=100
INTERVALO_COLETA_S=2
SEED=12345

# Pasta local para CSVs antes do upload S3 (padrão: temp/airpulse_bronze)
# PASTA_BRONZE_LOCAL=/tmp/airpulse_bronze